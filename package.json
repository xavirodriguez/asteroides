{
  "name": "asteroides",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean:artifacts": "find . -type f -path \"*/src/*\" \\( -name \"*.js\" -o -name \"*.js.map\" \\) -not -path \"*/node_modules/*\" -not -path \"*/dist/*\" -delete || true",
    "clean:full": "pnpm run clean:artifacts && rm -rf .turbo node_modules/.cache packages/*/.turbo server/.turbo temp etc/tsdoc-metadata.json dist compiled-js .expo && (watchman watch-del-all 2>/dev/null || true) && (rm -rf $TMPDIR/metro-* $TMPDIR/haste-map-* 2>/dev/null || true)",
    "start": "pnpm turbo run build && pnpm exec expo start",
    "buildtemp:js": "babel packages --extensions .ts,.tsx --out-dir compiled-js --copy-files",
    "android": "pnpm turbo run build && pnpm exec expo start --android",
    "ios": "pnpm turbo run build && pnpm exec expo start --ios",
    "web": "pnpm turbo run build && pnpm exec expo start --web",
    "build": "pnpm turbo run build && pnpm exec expo export",
    "test": "pnpm exec turbo run test",
    "lint": "pnpm turbo run lint",
    "lint:fix": "pnpm  turbo run lint -- --fix",
    "build:dev": "pnpm exec eas build --profile development --platform android",
    "build:preview": "pnpm exec eas build --profile preview --platform all",
    "build:prod": "pnpm exec eas build --profile production --platform all",
    "deploy:preview": "pnpm exec eas update --branch preview --message 'Preview deploy'",
    "deploy:prod": "pnpm exec eas update --branch production --message 'Production deploy'",
    "deploy:dev": "pnpm exec eas update --branch development --message 'Dev deploy'",
    "docs:generate": "pnpm exec api-documenter markdown -i temp -o docs/api-reference",
    "docs:extract": "pnpm --filter=@tiny-aster/core exec tsup src/index.ts src/games/asteroids/index.ts --format esm --dts-only --clean && node scripts/prepare-docs-directories.js && pnpm exec api-extractor run --local",
    "docs:check": "pnpm --filter=@tiny-aster/core exec tsup src/index.ts src/games/asteroids/index.ts --format esm --dts-only --clean && node scripts/prepare-docs-directories.js && pnpm exec api-extractor run",
    "docs:build": "pnpm docs:extract && pnpm docs:generate",
    "build:core": "pnpm --filter=@tiny-aster/core build",
    "typecheck:core": "pnpm --filter=@tiny-aster/core typecheck",
    "typecheck:app": "pnpm exec tsc -p tsconfig.json --noEmit",
    "check:core-boundaries": "bash ./scripts/check-core-boundaries.sh",
    "check:gameplay-kit-boundaries": "bash ./scripts/check-gameplay-kit-boundaries.sh",
    "check:ratchet": "pnpm exec tsx scripts/typecast-ratchet.ts",
    "ratchet:update": "pnpm exec tsx scripts/typecast-ratchet.ts --update",
    "check:duplication": "pnpm exec tsx scripts/duplication-ratchet.ts",
    "duplication:update-baseline": "pnpm exec tsx scripts/duplication-ratchet.ts --update",
    "detect:duplicates": "pnpm exec tsx scripts/detect-duplicates.ts",
    "story:lint": "pnpm exec tsx scripts/story-lint.ts",
    "validate:story": "pnpm run story:lint",
    "ci": "pnpm run build:core && pnpm --filter=@tiny-aster/gameplay-kit build && pnpm run check:core-boundaries && pnpm run check:gameplay-kit-boundaries && pnpm run check:ratchet && pnpm run check:duplication && pnpm run story:lint && pnpm run docs:check && pnpm run typecheck:app",
    "test:ci": "NODE_OPTIONS=\"--max-old-space-size=4096\" pnpm exec jest --runInBand"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.37",
    "@expo/dom-webview": "^0.1.5",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/ngrok": "4.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.6",
    "@shopify/react-native-skia": "2.4.18",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@tailwindcss/postcss": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "debug": "^4.4.3",
    "eas": "^0.1.0",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-doctor": "^1.20.1",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-keep-awake": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-screen-orientation": "~55.0.18",
    "expo-secure-store": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-updates": "~55.0.26",
    "expo-web-browser": "~55.0.18",
    "geist": "^1.4.2",
    "hermes-compiler": "^250829098.0.2",
    "input-otp": "^1.4.2",
    "msgpackr": "^1.11.12",
    "postcss": "^8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.45.3",
    "@babel/cli": "^7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.34.0",
    "@microsoft/api-documenter": "^7.28.9",
    "@microsoft/api-extractor": "^7.56.3",
    "@microsoft/tsdoc": "^0.16.0",
    "@microsoft/tsdoc-config": "^0.18.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "babel-preset-expo": "~55.0.8",
    "eas-cli": "^21.6.0",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "jiti": "^2.6.1",
    "jscpd": "^5.1.2",
    "react-native-worklets": "^0.7.2",
    "ts-jest": "^29.4.9",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.41.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
